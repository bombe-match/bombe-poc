<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BOMBE_PARTICIPANT_SECRET</_Parameter1>
      <_Parameter2>$(BOMBE_PARTICIPANT_SECRET)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="ValidateBombeParticipantSecret" BeforeTargets="CoreCompile" Condition="'$(BOMBE_PARTICIPANT_SECRET)' == ''">
    <Error Text="BOMBE_PARTICIPANT_SECRET is required. Inject it at build time; do not commit it to source." />
  </Target>

</Project>
